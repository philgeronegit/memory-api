# Production Environment Configuration Template
# Copy this file to .env on your production server and fill in actual values
# NEVER commit .env to version control!

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

DB_HOST=127.0.0.1
DB_USERNAME=production_db_user
DB_PASSWORD=CHANGE_TO_STRONG_PASSWORD
DB_DATABASE=memory_production

# ==============================================
# JWT AUTHENTICATION
# ==============================================

# Generate a strong secret key using: openssl rand -base64 64
# This key should be at least 256 bits (32 bytes) for HS256 algorithm
JWT_SECRET_KEY=CHANGE_TO_VERY_STRONG_SECRET_KEY_MINIMUM_256_BITS

JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME=3600
JWT_ISSUER=memory-api
JWT_AUDIENCE=memory-api-users

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

APP_ENV=production

# ==============================================
# PRODUCTION NOTES
# ==============================================

# 1. Database User Permissions:
#    Create a dedicated MySQL user with minimal privileges:
#    CREATE USER 'memory_user'@'localhost' IDENTIFIED BY 'strong_password';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON memory_production.* TO 'memory_user'@'localhost';
#    FLUSH PRIVILEGES;

# 2. JWT Secret Key:
#    Generate using: openssl rand -base64 64
#    Example: YourVeryLongAndRandomSecretKeyThatIsAtLeast256BitsLongForHS256AlgorithmSecurity==

# 3. Error Display:
#    Ensure error display is DISABLED in index.php:
#    Comment out or remove: ini_set('display_errors', 1);

# 4. CORS Configuration:
#    Update index.php with your production domain:
#    header("Access-Control-Allow-Origin: https://your-production-domain.com");

# 5. File Permissions:
#    chmod 600 .env
#    This file should only be readable by the web server user

# 6. Database Connection:
#    Verify MySQL is accessible from the application server
#    If using remote MySQL, update DB_HOST accordingly

# 7. Timezone:
#    Consider setting default timezone in index.php or php.ini:
#    date_default_timezone_set('UTC');
