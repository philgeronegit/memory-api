# FTP Deployment Credentials
# Copy this file to .env.deploy and fill in your actual values
# NEVER commit .env.deploy to version control!

# FTP Server Configuration
FTP_HOST=your-server.example.com
FTP_PORT=21
FTP_USER=your-username
FTP_PASSWORD=your-password

# Use passive mode (recommended for most servers, especially behind NAT/firewalls)
FTP_PASSIVE=true

# Remote path to your application directory (e.g., /var/www/html/memory or /public_html/memory)
FTP_REMOTE_PATH=/path/to/memory

# Backup location: "sibling" or "backups"
# - sibling: Creates backups like /path/to/memory_backup_20260107_143022/ next to your app
# - backups: Creates backups in /path/to/backups/memory_backup_20260107_143022/
BACKUP_LOCATION=sibling

# Number of backups to keep (older backups will be automatically deleted)
# Set to 0 to keep all backups
BACKUP_KEEP_COUNT=5
